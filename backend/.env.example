PORT=5000
NODE_ENV=development
CORS_ORIGIN=*
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql://livora:livora_dev_password@localhost:5432/livora_dev

# JWT
JWT_SECRET=livora-dev-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d

# SMTP (use Mailpit for dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@livora.dev

# OTP
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
